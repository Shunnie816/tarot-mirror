# Firebase Web SDK の設定値。
#
# これらは秘密情報ではない。クライアントバンドルに載る公開識別子で、
# データを守っているのは firestore.rules のほう。そのままコピーして使える。
#
#   cp apps/web/.env.example apps/web/.env.local
#
# 値が入っていなくてもアプリは動く（カードを引いて読むところまでは
# Firebase に一切触れないため）。その場合は保存だけが利用できない状態になる。

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDx8t2d69hgXqjvy4gTeB_zAQSgN83qw0Q
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tarot-mirror-a74b6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tarot-mirror-a74b6
NEXT_PUBLIC_FIREBASE_APP_ID=1:353031149616:web:19b1ef6c36361155ea75f5

# ローカルのエミュレータに繋ぐときだけ 1 にする。
# `pnpm emulators` と併せて使う。本番の設定値には影響しない。
NEXT_PUBLIC_FIREBASE_EMULATORS=
