rules_version = '2';

// Firestore セキュリティルール。
//
// ルールは加算的で、既定は拒否。ここに書かれていないパスは誰も読み書きできない。
// カードデータは Firestore に存在しない（不変で全ユーザー共通なのでバンドル同梱）ため、
// ここで守るのは利用者が自分で書いたものだけになる。
service cloud.firestore {
  match /databases/{database}/documents {

    // 自分の領域だけ。Journal は定義上プライベートで、共有機能は MVP に入れない。
    // 匿名ログインも request.auth を持つので、この一行で匿名利用者も守られる。
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // llmUsage/{uid} — LLM 整形の1日あたりの回数。
    //
    // ここに規則を書かないのが意図。既定が拒否なので、Admin SDK を持つ
    // Cloud Function だけが触れる。/users の下に置くと本人が自分の回数を
    // 0 に戻せてしまい、上限が飾りになる。守る相手がいる唯一のデータ。
  }
}
