{
  "name": "tarot-mirror",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore": "firebase emulators:exec --only firestore \"vitest run --workspace vitest.firestore.workspace.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --no-bail typecheck && tsc --noEmit -p tsconfig.tests.json",
    "validate:decks": "vitest run --project decks",
    "fetch:images": "tsx scripts/fetch-card-images.ts",
    "dev": "pnpm --filter @tarot-mirror/web dev",
    "build": "pnpm --filter @tarot-mirror/web build",
    "build:apphosting": "turbo run build --filter=@tarot-mirror/web --env-mode=loose",
    "emulators": "pnpm --filter @tarot-mirror/functions build && firebase emulators:start",
    "build:functions": "pnpm --filter @tarot-mirror/functions build",
    "demo:reading": "tsx scripts/demo-reading.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.64.0",
    "@tarot-mirror/decks": "workspace:*",
    "@tarot-mirror/engine": "workspace:*",
    "@types/node": "^22.20.5",
    "firebase": "^12.16.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
