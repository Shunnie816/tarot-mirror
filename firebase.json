{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "predeploy": [
      "node functions/build.mjs"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "src",
      "build.mjs",
      "tsconfig.json",
      "*.local"
    ]
  },
  "apphosting": [
    {
      "backendId": "tarot-mirror",
      "rootDir": "apps/web",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
