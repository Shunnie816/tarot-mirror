{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "predeploy": ["pnpm --filter @tarot-mirror/functions build"],
    "ignore": [
      "node_modules",
      ".git",
      "src",
      "build.mjs",
      "tsconfig.json",
      "*.local"
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
